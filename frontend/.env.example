# Copy to .env.local (never commit .env.local) and restart `npm run dev`.

# Supabase project, for "Sign in with Google". Both are public client values.
# Leave them unset to run the app without sign-in.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Detection backend (default http://<this host>:8000) and the desktop client's control API (default http://localhost:8001)
# VITE_BACKEND_URL=http://localhost:8000
# VITE_CLIENT_URL=http://localhost:8001
