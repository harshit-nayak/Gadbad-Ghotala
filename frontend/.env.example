# Copy to .env.local (never commit .env.local) and restart `npm run dev`.
# On Vercel, configure these in Project Settings -> Environment Variables.

# Supabase project credentials for authentication and OAuth (Google / GitHub).
# Both are public client values. Leave them unset to run open without sign-in.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Alternatively, legacy anon key is also supported:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Auth URL Configuration:
# In Supabase Dashboard -> Authentication -> URL Configuration:
#   Site URL: https://your-project.vercel.app
#   Redirect URLs:
#     https://your-project.vercel.app/**
#     http://localhost:5173/**

# Optional: Live detection backend and capture client URL
# VITE_BACKEND_URL=https://your-backend-url.com
# VITE_CLIENT_URL=http://localhost:8001
# Required if the backend was started with AUTH_TOKEN set (app/config.py).
# Note: this ships in the client bundle like any other VITE_ var, so it only
# gates casual/bot traffic -- it is not a true secret.
# VITE_BACKEND_TOKEN=same-value-as-the-backend-AUTH_TOKEN

