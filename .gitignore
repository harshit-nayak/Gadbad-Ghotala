# --- Secrets / local state — never commit -----------------------------------
# Root CA private key + CA working area
/.ca/
# Per-user signing state and the local enrolment index
/.docsign/
*.key.pem
root_ca_key.pem
# The root cert is generated per deployment by `docsign init-ca`
/trust/*
!/trust/.gitkeep

# Signed artefacts produced while testing
*.sig

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
